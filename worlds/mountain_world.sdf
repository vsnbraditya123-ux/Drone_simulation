<?xml version="1.0" ?>
<!-- ======================================================================= -->
<!--                  HIGH-FIDELITY MOUNTAIN TERRAIN WORLD                   -->
<!--                 PX4 Gazebo Sim Hyper-Realistic World                    -->
<!-- ======================================================================= -->
<sdf version="1.8">
  <world name="mountain_world">

    <!-- =================================================================== -->
    <!-- PHYSICS ENGINE CONFIGURATION                                        -->
    <!-- =================================================================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- =================================================================== -->
    <!-- GAZEBO SYSTEM PLUGINS                                               -->
    <!-- =================================================================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- =================================================================== -->
    <!-- ATMOSPHERE, SKY, AND LIGHTING                                       -->
    <!-- =================================================================== -->
    <scene>
      <ambient>0.6 0.6 0.65 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <time>14</time>
        <clouds>
          <speed>15</speed>
          <humidity>0.5</humidity>
        </clouds>
      </sky>
    </scene>

    <!-- Sun Light Source -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.95 0.95 0.9 1.0</diffuse>
      <specular>0.4 0.4 0.4 1.0</specular>
      <direction>-0.5 0.2 -0.85</direction>
    </light>

    <!-- Sky Fill Light -->
    <light type="directional" name="sky_fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.2 0.3 0.4 1.0</diffuse>
      <specular>0.0 0.0 0.0 1.0</specular>
      <direction>0.5 -0.2 0.85</direction>
    </light>

    <!-- =================================================================== -->
    <!-- TERRAIN MESHES AND ELEVATION LAYERS                                 -->
    <!-- =================================================================== -->

    <!-- Base Valley Floor Plane -->
    <model name="alpine_valley_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3000 3000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3000 3000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.4 0.18 1</ambient>
            <diffuse>0.25 0.4 0.18 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central Mountain Peak (Primary Rubicon Mesh) -->
    <include>
      <name>central_mountain_peak</name>
      <uri>model://rubicon</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- North Mountain Ridge -->
    <include>
      <name>north_mountain_ridge</name>
      <uri>model://rubicon</uri>
      <pose>0 350 -15 0 0 0</pose>
    </include>

    <!-- South Mountain Ridge -->
    <include>
      <name>south_mountain_ridge</name>
      <uri>model://rubicon</uri>
      <pose>0 -350 -15 0 0 3.1415</pose>
    </include>

    <!-- East Mountain Ridge -->
    <include>
      <name>east_mountain_ridge</name>
      <uri>model://rubicon</uri>
      <pose>350 0 -15 0 0 1.5708</pose>
    </include>

    <!-- West Mountain Ridge -->
    <include>
      <name>west_mountain_ridge</name>
      <uri>model://rubicon</uri>
      <pose>-350 0 -15 0 0 -1.5708</pose>
    </include>

    <!-- North-East Corner Peak -->
    <include>
      <name>ne_corner_peak</name>
      <uri>model://rubicon</uri>
      <pose>280 280 -25 0 0 0.7854</pose>
    </include>

    <!-- North-West Corner Peak -->
    <include>
      <name>nw_corner_peak</name>
      <uri>model://rubicon</uri>
      <pose>-280 280 -25 0 0 -0.7854</pose>
    </include>

    <!-- South-East Corner Peak -->
    <include>
      <name>se_corner_peak</name>
      <uri>model://rubicon</uri>
      <pose>280 -280 -25 0 0 2.3562</pose>
    </include>

    <!-- South-West Corner Peak -->
    <include>
      <name>sw_corner_peak</name>
      <uri>model://rubicon</uri>
      <pose>-280 -280 -25 0 0 -2.3562</pose>
    </include>

    <!-- =================================================================== -->
    <!-- DENSE ALPINE PINE FOREST SECTORS                                   -->
    <!-- =================================================================== -->

    <!-- Forest Sector 1: North Valley Slope -->
    <include><name>pine_n_01</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>15 80 5 0 0 0.1</pose></include>
    <include><name>pine_n_02</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>25 85 7 0 0 0.4</pose></include>
    <include><name>pine_n_03</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-10 90 8 0 0 1.2</pose></include>
    <include><name>pine_n_04</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>35 95 10 0 0 2.1</pose></include>
    <include><name>pine_n_05</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-25 100 12 0 0 0.9</pose></include>
    <include><name>pine_n_06</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>45 105 14 0 0 1.8</pose></include>
    <include><name>pine_n_07</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-35 110 16 0 0 2.7</pose></include>
    <include><name>pine_n_08</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>10 115 18 0 0 0.3</pose></include>
    <include><name>pine_n_09</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-15 120 20 0 0 1.5</pose></include>
    <include><name>pine_n_10</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>30 125 22 0 0 2.2</pose></include>
    <include><name>pine_n_11</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-40 130 24 0 0 0.6</pose></include>
    <include><name>pine_n_12</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>50 135 26 0 0 1.1</pose></include>

    <!-- Forest Sector 2: South Valley Slope -->
    <include><name>pine_s_01</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>20 -80 5 0 0 0.2</pose></include>
    <include><name>pine_s_02</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-20 -85 7 0 0 0.8</pose></include>
    <include><name>pine_s_03</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>30 -90 9 0 0 1.4</pose></include>
    <include><name>pine_s_04</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-35 -95 11 0 0 2.3</pose></include>
    <include><name>pine_s_05</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>15 -100 13 0 0 0.5</pose></include>
    <include><name>pine_s_06</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-15 -105 15 0 0 1.9</pose></include>
    <include><name>pine_s_07</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>40 -110 17 0 0 2.8</pose></include>
    <include><name>pine_s_08</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-45 -115 19 0 0 0.1</pose></include>
    <include><name>pine_s_09</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>25 -120 21 0 0 1.3</pose></include>
    <include><name>pine_s_10</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-25 -125 23 0 0 2.5</pose></include>

    <!-- Forest Sector 3: East Mountain Slope -->
    <include><name>pine_e_01</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>80 15 5 0 0 0.3</pose></include>
    <include><name>pine_e_02</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>85 -25 7 0 0 1.1</pose></include>
    <include><name>pine_e_03</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>90 35 9 0 0 2.0</pose></include>
    <include><name>pine_e_04</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>95 -40 11 0 0 0.7</pose></include>
    <include><name>pine_e_05</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>100 45 13 0 0 1.6</pose></include>
    <include><name>pine_e_06</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>105 -50 15 0 0 2.9</pose></include>
    <include><name>pine_e_07</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>110 55 17 0 0 0.4</pose></include>
    <include><name>pine_e_08</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>115 -60 19 0 0 1.8</pose></include>

    <!-- Forest Sector 4: West Mountain Slope -->
    <include><name>pine_w_01</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-80 20 5 0 0 0.5</pose></include>
    <include><name>pine_w_02</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-85 -15 7 0 0 1.3</pose></include>
    <include><name>pine_w_03</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-90 30 9 0 0 2.2</pose></include>
    <include><name>pine_w_04</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-95 -35 11 0 0 0.8</pose></include>
    <include><name>pine_w_05</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-100 40 13 0 0 1.7</pose></include>
    <include><name>pine_w_06</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-105 -45 15 0 0 3.0</pose></include>
    <include><name>pine_w_07</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-110 50 17 0 0 0.2</pose></include>
    <include><name>pine_w_08</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Pine%20Tree</uri><pose>-115 -55 19 0 0 1.4</pose></include>

    <!-- =================================================================== -->
    <!-- LOCAL GEOMETRY STRUCTURES & MOUNTAIN BASE                           -->
    <!-- =================================================================== -->

    <!-- Mountain Outpost Helipad Platform -->
    <model name="mountain_helipad_station">
      <static>true</static>
      <pose>0 0 35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>16 16 2</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>16 16 2</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Weather Research Outpost Hangar -->
    <model name="mountain_research_hangar">
      <static>true</static>
      <pose>40 40 0 0 0 0.7854</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>22 14 9</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>22 14 9</size></box></geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
            <diffuse>0.5 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ridge Wind Energy Turbines -->
    <model name="ridge_turbine_north">
      <static>true</static>
      <pose>0 200 15 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.8</radius><length>32</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.8</radius><length>32</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="ridge_turbine_south">
      <static>true</static>
      <pose>0 -200 15 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.8</radius><length>32</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.8</radius><length>32</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- DYNAMIC 3D FOLLOW CAMERA (LOCKS ON DRONE)                           -->
    <!-- =================================================================== -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-12 -12 45 0 0.45 0.785</pose>
        <track_visual>
          <name>x500</name>
          <min_dist>5.0</min_dist>
          <max_dist>35.0</max_dist>
          <static>false</static>
          <use_model_frame>true</use_model_frame>
        </track_visual>
      </camera>
    </gui>

  </world>
</sdf>
